---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  category: string;
  title: string;
  description: string;
  intro: string;
}

const { category, title, description, intro } = Astro.props;

const articles = await getCollection('articles', ({ data }) =>
  data.category === category
);

const groupedArticles = articles.reduce<Record<string, typeof articles>>(
  (groups, article) => {
    const subcategory = article.data.subcategory ?? 'Other';

    if (!groups[subcategory]) {
      groups[subcategory] = [];
    }

    groups[subcategory].push(article);

    return groups;
  },
  {}
);
---

<BaseLayout title={`${title} | HVACTechLab`} description={description}>
  <h1>{title}</h1>

  <p class="page-intro">
    {intro}
  </p>

  {Object.entries(groupedArticles).map(([subcategory, subcategoryArticles]) => (
    <section class="article-group">
      <h2>{subcategory}</h2>

      <ul class="article-list">
        {subcategoryArticles.map((article) => (
          <li>
            <h3>
              <a href={`/${article.id}/`}>
                {article.data.title}
              </a>
            </h3>

            <p>{article.data.description}</p>

            <p class="article-meta">
              {article.data.publishedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>