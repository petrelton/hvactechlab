---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

articles.sort(
  (a, b) =>
    b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);
---

<BaseLayout
  title="HVAC Articles | HVACTechLab"
  description="HVAC guides, troubleshooting advice, costs, comparisons and buying information."
>
  <h1>HVAC Articles</h1>

  <p>
    Practical HVAC guides covering air conditioning, heating, heat pumps,
    costs, maintenance and more.
  </p>

  <ul>
    {articles.map((article) => (
      <li>
        <h2>
          <a href={`/${article.id}/`}>
            {article.data.title}
          </a>
        </h2>

        <p>{article.data.description}</p>

        <p>
          <small>
            {article.data.category} ·{' '}
            {article.data.publishedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </small>
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>